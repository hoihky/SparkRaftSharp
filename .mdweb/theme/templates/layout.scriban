<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }} · {{ site_title }}</title>
  <meta name="description" content="{{ site_description }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ asset_prefix }}assets/css/portfolio.css">
  <link rel="stylesheet" href="{{ asset_prefix }}assets/css/sparkraft-docs.css">
  <link rel="stylesheet" href="{{ asset_prefix }}assets/vendor/atom-one-dark.min.css">
</head>
<body>
  <div class="site">
    <header class="topbar">
      <a href="{{ home_url }}" class="brand">{{ site_title }}</a>
      <nav class="topbar-nav" aria-label="Primary">
        <a href="{{ home_url }}">Overview</a>
        <a href="{{ rel_prefix }}quickstart.html">Quickstart</a>
        <a href="{{ rel_prefix }}raft-protocol.html">Raft guide</a>
        <a href="{{ rel_prefix }}architecture.html">Architecture</a>
        <a href="{{ rel_prefix }}features.html">Features</a>
        <a href="{{ rel_prefix }}roadmap.html">Roadmap</a>
        <a href="{{ rel_prefix }}simple-cluster.html">Demo</a>
      </nav>
    </header>

    <main class="portfolio-layout">
      <div class="portfolio-main doc-body">
        <header class="doc-header">
          <h1>{{ page_title }}</h1>
        </header>
        __MDWEB_CONTENT__
        <footer class="doc-footer">
          __MDWEB_FOOTER__
        </footer>
      </div>

      {{ if table_of_contents.size > 0 }}
      <aside class="toc" aria-label="On this page">
        <p class="toc-title">On this page</p>
        <ul>
          {{ for heading in table_of_contents }}
          <li class="toc-h{{ heading.level }}">
            <a href="#{{ heading.id }}">{{ heading.text }}</a>
          </li>
          {{ end }}
        </ul>
      </aside>
      {{ end }}
    </main>
  </div>
  <script src="{{ asset_prefix }}assets/vendor/mermaid.min.js"></script>
  <script src="{{ asset_prefix }}assets/vendor/highlight.min.js"></script>
  <script src="{{ asset_prefix }}assets/js/site.js"></script>
</body>
</html>
